{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ff-version-check",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/ff-watch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/hide-expired",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/event-status",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/purge-expired",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/checkin-reminder",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/bxh-rank-notify",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/shop-stale-orders",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "src/app/api/admin/sql/route.ts": { "maxDuration": 30 },
    "src/app/api/admin/settings/migrate-encrypt/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/daily-report/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/auth-report/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/event-reminders/route.ts": { "maxDuration": 30 },
    "src/app/api/streams/sync/route.ts": { "maxDuration": 30 },
    "src/app/api/tms/tournaments/[id]/generate-matches/route.ts": { "maxDuration": 30 },
    "src/app/api/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/admin/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/ff-version-check/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/publish-scheduled/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/digest/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/hide-expired/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/event-status/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/purge-expired/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/checkin-reminder/route.ts": { "maxDuration": 60 },
    "src/app/api/cron/shop-stale-orders/route.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/dmca-validation.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
