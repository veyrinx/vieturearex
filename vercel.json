{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ff-version-check",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/admin/sql/route.ts": { "maxDuration": 30 },
    "src/app/api/admin/settings/migrate-encrypt/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/daily-report/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/event-reminders/route.ts": { "maxDuration": 30 },
    "src/app/api/streams/sync/route.ts": { "maxDuration": 30 },
    "src/app/api/tms/tournaments/[id]/generate-matches/route.ts": { "maxDuration": 30 },
    "src/app/api/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/admin/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/ff-version-check/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/publish-scheduled/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/dmca-validation.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
