{
  "name": "arex-hub",
  "version": "1.1.0",
  "private": true,
  "description": "Arex Hub — app quản trị native (iOS/Android) cho hệ thống Arex Network",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "sync": "npm run build && node scripts/sync-ios-version.mjs && cap sync",
    "assets": "node scripts/make-source-assets.mjs && capacitor-assets generate --ios --android --iconBackgroundColor #0b0f1a --iconBackgroundColorDark #0b0f1a --splashBackgroundColor #070b14 --splashBackgroundColorDark #070b14",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "npm run build && node scripts/sync-ios-version.mjs && cap run ios",
    "run:android": "npm run build && cap run android",
    "build:android:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "build:android:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-updater": "^8.51.2",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
