{
  "name": "arex-mobile",
  "version": "1.1.0",
  "private": true,
  "description": "Arex Network — vỏ native iOS/Android bọc giao diện web (Capacitor)",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor #0a0a0a --iconBackgroundColorDark #0a0a0a --splashBackgroundColor #0a0a0a --splashBackgroundColorDark #0a0a0a",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "build:android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "typescript": "^5.9.3"
  }
}
