# ============================================================
# AREX - ENVIRONMENT VARIABLES
# © 2026 Arex. All Rights Reserved.
# ============================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!
# ============================================================

# SUPABASE AUTHENTICATION & DATABASE
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# You can also use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY as a fallback for compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# SITE URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GHIM SITE (để trống = tắt)
# Repo này phục vụ 2 tên miền: arexnetwork.site (arex) và iscnetwork.site (isc).
# Không đặt biến -> mỗi request đọc header Host để biết mình là site nào. Cái giá
# là MỌI trang phải render động, không trang nào nằm được trong cache CDN, mỗi
# lượt xem là một lần chạy function tính tiền trên Vercel.
#
# Đặt biến -> bản triển khai biết trước mình là site nào, khỏi đọc header, và các
# trang lại được cache theo `export const revalidate` của chính nó.
#
# CẢNH BÁO: chỉ đặt khi project Vercel này phục vụ ĐÚNG MỘT tên miền. Cache ISR
# đánh theo đường dẫn chứ không theo tên miền, nên một project ôm cả 2 tên miền mà
# bật ghim thì hai site sẽ ăn nhầm HTML đã cache của nhau.
# Cách làm đúng: tách mỗi tên miền sang một project Vercel riêng (cùng repo), rồi
# project của arexnetwork.site đặt arex, project của iscnetwork.site đặt isc.
# NEXT_PUBLIC_SITE_ID=arex

# ADMIN EMAIL DOMAIN (domain dùng cho tài khoản admin, VD: arexnetwork.site)
# Mặc định tự động lấy từ NEXT_PUBLIC_SITE_URL nếu không đặt
ADMIN_EMAIL_DOMAIN=arexnetwork.site
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=arexnetwork.site

# EMAIL DELIVERY FOR ADMIN INVITATIONS
RESEND_API_KEY=re_xxxxxxxxx
ADMIN_INVITE_FROM_EMAIL=Arex Admin <noreply@arex.tech>
ADMIN_INVITE_REPLY_TO_EMAIL=support@arex.tech

# GMAIL SMTP FOR CONTACT FORM
GMAIL_USER=admin@arex.tech
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# DATABASE CONFIGURATION
DISABLE_SUPABASE_RUNTIME=false
SUPABASE_QUERY_TIMEOUT_MS=8000

# FREE FIRE INFO API (tự động lấy tên/level/rank từ ID FF ở máy định giá nick)
# KHÔNG có API chính thức của Garena — dùng API bên thứ 3 (không chính thức, có thể sập).
# Để trống = tắt tính năng, người dùng nhập tay. Template phải có {uid} và {region}.
# Ví dụ (tự host free-ff-api của jinix6, hoặc dịch vụ có key):
#   FF_INFO_API_URL=https://your-host/api/v1/account?region={region}&uid={uid}
FF_INFO_API_URL=
FF_INFO_REGION=VN

# GOOGLE SHEETS - Đánh giá bài viết
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# HL Gaming Official Free Fire API (server-only) — https://www.hlgamingofficial.com/p/api.html
HLFF_API_KEY=
HLFF_USER_UID=arex
HLFF_REGION=vn

# FIREBASE CLOUD MESSAGING — thông báo đẩy cho app native (iOS + Android)
# Khác web push của trình duyệt (dùng VAPID_* + bảng push_subscriptions).
# Lấy ở Firebase Console → Project settings → Service accounts →
# Generate new private key, rồi chép 3 giá trị từ file JSON tải về.
# Điền được luôn trong /admin/settings (mục Firebase) — settings ưu tiên hơn,
# 3 biến dưới đây chỉ là dự phòng. Để trống cả hai = tắt push native, web push
# vẫn chạy bình thường.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CHỢ AREX — khoá mã hoá thông tin bàn giao (tài khoản/mật khẩu game)
# Dùng cho AES-256-GCM ở src/lib/server/shop-crypto.ts trước khi ghi xuống cột
# shop_order_events.secret. Để trống thì tự lấy APP_SECRET / NEXT_REDIRECT_SECRET
# / SUPABASE_SERVICE_ROLE_KEY làm nguồn.
# ĐẶT MỘT LẦN RỒI ĐỪNG ĐỔI: đổi khoá là mọi bản ghi cũ hết giải mã được.
SHOP_SECRET_KEY=

# DISCORD BOT — toàn bộ cấu hình đặt được trong /admin/settings (mục "Discord
# Bot"), không cần deploy lại. Mọi biến DISCORD_* dưới đây chỉ còn là dự phòng
# khi ô tương ứng trong admin để trống. Token lưu trong DB được mã hoá AES bằng
# APP_SECRET và không bao giờ trả ngược ra client.
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Dùng để xác thực chữ ký cho /api/discord/interactions
# (Developer Portal > General Information > Public Key)
DISCORD_PUBLIC_KEY=

DISCORD_GUILD_ID=
DISCORD_SHOP_CHANNEL_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_TICKET_CHANNEL_ID=
DISCORD_EVENT_CHANNEL_ID=
DISCORD_AGENT_ROLE_ID=
DISCORD_LINKED_ROLE_ID=
DISCORD_SELLER_ROLE_ID=
DISCORD_STAFF_ROLE_ID=
